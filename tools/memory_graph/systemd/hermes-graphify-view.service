[Unit]
Description=Hermes Graphify localhost viewer
After=network.target hermes-graphify-pilot.service

[Service]
Type=simple
User=hermes
Group=hermes
WorkingDirectory=/srv/hermes-memory/indexes/graphify/personal-anton-pilot/output/graphify-out
ExecStart=/usr/bin/python3 -m http.server 8765 --bind 127.0.0.1
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/srv/hermes-memory/indexes/graphify/personal-anton-pilot/output/graphify-out

[Install]
WantedBy=multi-user.target
