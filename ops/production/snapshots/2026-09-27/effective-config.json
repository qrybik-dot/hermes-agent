      "research": 28,
      "planning": 30,
      "coding": 30,
      "long_context": 30,
      "server_debug": 30,
      "expert_analysis": 30
    }
  },
  "skills": {
    "write_approval": true,
    "guard_agent_created": true
  },
  "auxiliary_background_review_enabled": false,
  "memory": {
    "memory_enabled": false,
    "user_profile_enabled": false
  },
  "curator_enabled": false
}
