[Unit]
Description=Hermes Gateway startup Telegram notifier
After=hermes-gateway.service

[Service]
Type=oneshot
User=hermes
Group=hermes
SupplementaryGroups=systemd-journal
WorkingDirectory=/home/hermes/.hermes
EnvironmentFile=-/home/hermes/.hermes/.env
ExecStart=/home/hermes/hermes-v018-integration/.venv/bin/python /home/hermes/.hermes/scripts/hermes_startup_notify.py
TimeoutStartSec=60
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=hermes-gateway.service
