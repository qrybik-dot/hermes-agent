[Unit]
Description=Hermes deterministic terminal-task report finalizer v2
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=hermes
Group=hermes
WorkingDirectory=/home/hermes/hermes-runtime/current
Environment=HERMES_HOME=/home/hermes/.hermes
ExecStart=/usr/bin/python3 /usr/local/lib/hermes-report-finalizer.py
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=false
ReadWritePaths=/home/hermes/.hermes/reports /home/hermes/.hermes/logs /home/hermes/.hermes/report-finalizer
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true
MemoryMax=160M
CPUQuota=35%
TimeoutStartSec=150
