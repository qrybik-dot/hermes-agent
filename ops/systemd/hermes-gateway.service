[Unit]
Description=Hermes Agent Gateway - Messaging Platform Integration
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=hermes
Group=hermes
ExecStart=/home/hermes/hermes-v018-integration/.venv/bin/python -m hermes_cli.main gateway run --replace
ExecStop=/home/hermes/hermes-v018-integration/.venv/bin/python /home/hermes/hermes-v018-integration/ops/systemd/hermes_gateway_planned_stop.py $MAINPID
WorkingDirectory=/home/hermes/hermes-v018-integration
Environment="HOME=/home/hermes"
Environment="USER=hermes"
Environment="LOGNAME=hermes"
Environment="PATH=/home/hermes/hermes-v018-integration/.venv/bin:/home/hermes/.hermes/node/bin:/home/hermes/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="VIRTUAL_ENV=/home/hermes/hermes-v018-integration/.venv"
Environment="HERMES_HOME=/home/hermes/.hermes"
Restart=always
RestartSec=5
RestartMaxDelaySec=300
RestartSteps=5
RestartForceExitStatus=75
KillMode=mixed
KillSignal=SIGTERM
ExecReload=/bin/kill -USR1 $MAINPID
TimeoutStopSec=210
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
